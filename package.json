{
  "name": "vsquirrel-prover",
  "displayName": "VSquirrel Prover",
  "description": "VScod{e,ium} extension for Squirrel proof assistant.",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "proof assistant"
  ],
  "publisher": "tresml-lang",
  "icon": "./icons/squirrel_logo.png",
  "version": "0.5.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zacharie-moughanim/vsquirrel.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsquirrel.startProof",
        "title": "Start Proof",
        "icon": "$(debug-start)"
      },
      {
        "command": "vsquirrel.closeProof",
        "title": "Close proof",
        "icon": "$(debug-stop)"
      },
      {
        "command": "vsquirrel.nextProof",
        "title": "Proof Next Point"
      },
      {
        "command": "vsquirrel.undoProof",
        "title": "Undo last proof command"
      },
      {
        "command": "vsquirrel.goToProof",
        "title": "Interpret to the position of the cursor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == squirrel-prover && editorTextFocus",
          "command": "vsquirrel.startProof",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == squirrel-prover && editorTextFocus",
          "command": "vsquirrel.closeProof",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vsquirrel.nextProof",
        "key": "alt+down",
        "mac": "ctrl+alt+down",
        "when": "resourceLangId == squirrel-prover && editorTextFocus"
      },
      {
        "command": "vsquirrel.undoProof",
        "key": "alt+up",
        "mac": "ctrl+alt+up",
        "when": "resourceLangId == squirrel-prover && editorTextFocus"
      },
      {
        "command": "vsquirrel.goToProof",
        "key": "alt+right",
        "mac": "ctrl+alt+right",
        "when": "resourceLangId == squirrel-prover && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "VSquirrel Prover",
      "type": "object",
      "properties": {
        "vsquirrel.lsp.pythonInterpreterPath": {
          "type": "string",
          "markdownDescription": "Path to a python interpreter used to run the LSP server. default:python",
          "default": "python",
          "order": 0
        },
        "vsquirrel.squirrelPath": {
          "type": "string",
          "markdownDescription": "Path to squirrel. default:~/squirrel-prover/squirrel",
          "default": "~/squirrel-prover/squirrel",
          "order": 1
        },
        "vsquirrel.webviewFontSize": {
          "type": "number",
          "markdownDescription": "Font size in webview (proof goals, etc)",
          "default": "12",
          "order": 1
        },
        "vsquirrel.highlightAdmit": {
          "type": "boolean",
          "markdownDescription": "Whether to highlight processed `admit` commands in a proof.",
          "default": "true",
          "order": 2
        },
        "vsquirrel.highlightAbort": {
          "type": "boolean",
          "markdownDescription": "Whether to highlight processed `Abort` commands in a proof.",
          "default": "true",
          "order": 3
        }
      }
    },
    "colors": [
      {
        "id": "vsquirrel.proof.processing",
        "description": "Highlighting color for a proof in processing.",
        "defaults": {
          "dark": "#7ae79e57",
          "highContrast": "#7ae79e57",
          "light": "#7ae79e57",
          "highContrastLight": "#7ae79e57"
        }
      },
      {
        "id": "vsquirrel.proof.processed",
        "description": "Highlighting color for processed proof.",
        "defaults": {
          "dark": "#006b2457",
          "highContrast": "#006b2457",
          "light": "#006b2457",
          "highContrastLight": "#006b2457"
        }
      },
      {
        "id": "vsquirrel.proof.error",
        "description": "Highlighting color for proof that triggered an error.",
        "defaults": {
          "dark": "#ff000057",
          "highContrast": "#ff000057",
          "light": "#ff000057",
          "highContrastLight": "#ff000057"
        }
      },
      {
        "id": "vsquirrel.proof.admit",
        "description": "Highlighting color for admitted part of a proof.",
        "defaults": {
          "dark": "#ffee00",
          "highContrast": "#ffee00",
          "light": "#ffee00",
          "highContrastLight": "#ffee00"
        }
      },
      {
        "id": "vsquirrel.proof.abort",
        "description": "Highlighting color for aborted part of a proof.",
        "defaults": {
          "dark": "#ff7700",
          "highContrast": "#ff7700",
          "light": "#ff7700",
          "highContrastLight": "#ff7700"
        }
      }
    ],
    "languages": [
      {
        "id": "squirrel-prover",
        "extensions": [
          ".sp"
        ],
        "aliases": [
          "SquirrelProver"
        ],
        "filenames": [],
        "configuration": "./squirrel-prover-language-configuration.json",
        "icon": {
          "light": "./icons/squirrel_light.svg",
          "dark": "./icons/squirrel_dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "squirrel-prover",
        "scopeName": "source.squirrel-prover",
        "path": "./syntax/squirrel-prover.tmGrammar.json"
      }
    ]
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "ansi-to-html": ">0.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@vscode/vsce": "^3.7.1",
    "ansi-to-html": ">0.0.0",
    "glob": "^11.0.0",
    "npm-run-all": "^4.1.5",
    "vsce": "^1.103.1"
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production"
  }
}
