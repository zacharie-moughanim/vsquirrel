{
  "name": "vsquirrel",
  "displayName": "VSquirrel",
  "description": "VScod{e,ium} extension for Squirrel proof assistant.",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "proof assistant"
  ],
  "publisher": "tresml-lang",
  "icon": "./icons/squirrel_logo.png",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zacharie-moughanim/vsquirrel.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsquirrel.startProof",
        "title": "Start Proof",
        "icon": "$(debug-start)"
      },
      {
        "command": "vsquirrel.closeProof",
        "title": "Close proof",
        "icon": "$(debug-stop)"
      },
      {
        "command": "vsquirrel.killServer",
        "title": "Kill LSP server"
      },
      {
        "command": "vsquirrel.nextProof",
        "title": "Proof Next Point"
      },
      {
        "command": "vsquirrel.undoProof",
        "title": "Undo last proof command"
      },
      {
        "command": "vsquirrel.goToProof",
        "title": "Interpret to the position of the cursor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == squirrel-prover && editorTextFocus",
          "command": "vsquirrel.startProof",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == squirrel-prover && editorTextFocus",
          "command": "vsquirrel.closeProof",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vsquirrel.nextProof",
        "key": "alt+down",
        "mac": "ctrl+alt+down",
        "when": "resourceLangId == squirrel-prover && editorTextFocus"
      },
      {
        "command": "vsquirrel.undoProof",
        "key": "alt+up",
        "mac": "ctrl+alt+up",
        "when": "resourceLangId == squirrel-prover && editorTextFocus"
      },
      {
        "command": "vsquirrel.goToProof",
        "key": "alt+right",
        "mac": "ctrl+alt+right",
        "when": "resourceLangId == squirrel-prover && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "VSquirrel Prover",
      "type": "object",
      "properties": {
        "vsquirrel.lsp.pythonInterpreterPath": {
          "type": "string",
          "markdownDescription": "Path to a python interpreter used to run the LSP server. default:python",
          "default": "python",
          "order": 0
        },
        "vsquirrel.squirrelPath": {
          "type": "string",
          "markdownDescription": "Path to squirrel. default:~/squirrel-prover/squirrel",
          "default": "~/squirrel-prover/squirrel",
          "order": 1
        }
      }
    },
    "colors": [
      {
        "id": "vsquirrel.proof.processing",
        "description": "Highlighting color for a proof in processing.",
        "defaults": {
          "dark": "#00f04823",
          "highContrast": "#00f04823",
          "light": "#00f04823",
          "highContrastLight": "#00f04823"
        }
      },
      {
        "id": "vsquirrel.proof.processed",
        "description": "Highlighting color for processed proof.",
        "defaults": {
          "dark": "#00f04857",
          "highContrast": "#00f04857",
          "light": "#00f04857",
          "highContrastLight": "#00f04857"
        }
      },
      {
        "id": "vsquirrel.proof.error",
        "description": "Highlighting color for proof that triggered an error.",
        "defaults": {
          "dark": "#ff000057",
          "highContrast": "#ff000057",
          "light": "#ff000057",
          "highContrastLight": "#ff000057"
        }
      },
      {
        "id": "vsquirrel.proof.warning",
        "description": "Highlighting color for warning in a proof (typically `Abort` and `admit`).",
        "defaults": {
          "dark": "#f0e00057",
          "highContrast": "#f0e00057",
          "light": "#f0e00057",
          "highContrastLight": "#f0e00057"
        }
      }
    ],
    "languages": [
      {
        "id": "squirrel-prover",
        "extensions": [
          ".sp"
        ],
        "aliases": [
          "SquirrelProver"
        ],
        "filenames": [],
        "configuration": "./squirrel-prover-language-configuration.json",
        "icon": {
          "light": "./icons/squirrel_light.svg",
          "dark": "./icons/squirrel_dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "squirrel-prover",
        "scopeName": "source.squirrel-prover",
        "path": "./syntax/squirrel-prover.tmGrammar.json"
      }
    ]
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "ansi-to-html": ">0.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@vscode/vsce": "^3.7.1",
    "ansi-to-html": ">0.0.0",
    "glob": "^11.0.0",
    "vsce": "^1.97.0"
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production"
  }
}
